[
  {
    "id": "tab1",
    "type": "tab",
    "label": "Station tags",
    "info": "Reads the soft PLC's OPC-UA tags (ns=2) every 250 ms and shows them as lamps \u2014 proof the alert is a real protocol write, not a coloured div. Endpoint opc.tcp://127.0.0.1:4840; leave the server URL at its default (docs/adr/0007)."
  },
  {
    "id": "ep1",
    "type": "OpcUa-Endpoint",
    "endpoint": "opc.tcp://127.0.0.1:4840",
    "secpol": "None",
    "secmode": "None",
    "none": true,
    "login": false,
    "usercert": false,
    "usercertificate": "",
    "userprivatekey": ""
  },
  {
    "id": "base1",
    "type": "ui-base",
    "name": "TorqueSense",
    "path": "/dashboard",
    "includeClientData": true,
    "acceptsClientConfig": [
      "ui-notification",
      "ui-control"
    ],
    "showPathInSidebar": false,
    "navigationStyle": "none"
  },
  {
    "id": "theme1",
    "type": "ui-theme",
    "name": "Shop floor",
    "colors": {
      "surface": "#171A21",
      "primary": "#0E7C86",
      "bgPage": "#0F1115",
      "groupBg": "#171A21",
      "groupOutline": "#2A2F3A"
    },
    "sizes": {
      "pagePadding": "12px",
      "groupGap": "12px",
      "groupBorderRadius": "8px",
      "widgetGap": "12px"
    }
  },
  {
    "id": "page1",
